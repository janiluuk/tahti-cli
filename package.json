{
  "name": "tahti-cli",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Terminal-first CLI for Tahti \u2014 scriptable API access and an interactive shell (mpv).",
  "bin": {
    "tahti": "./dist/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/janiluuk/tahti-cli.git"
  },
  "homepage": "https://github.com/janiluuk/tahti-cli",
  "bugs": {
    "url": "https://github.com/janiluuk/tahti-cli/issues"
  },
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tahti": "node ./dist/cli.js",
    "sdk:pack-from-org": "node scripts/pack-sdk-from-org.mjs",
    "sdk:latest": "node scripts/install-sdk.mjs",
    "prebuild": "pnpm sdk:latest",
    "build": "tsc -p tsconfig.build.json",
    "build:offline": "tsc -p tsconfig.build.json",
    "type-check": "tsc"
  },
  "dependencies": {
    "@tahti/api-client": "file:vendor/tahti-api-client-0.1.0.tgz",
    "blessed": "^0.1.81"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/blessed": "^0.1.27",
    "@types/node": "^24.13.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "globals": "^17.0.0",
    "prettier": "3.9.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
